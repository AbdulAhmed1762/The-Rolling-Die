<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>

    <h1>The Rolling Die</h1>
    <h2>Manager Dashboard</h2>

    <a href ="/manager/games/add">
        <button type="button">Add New Game </button>
    </a>

    <h3>Current Inventory</h3>

    {{#games}}
        <div>
            <h4>{{title}}</h4>
            <p>Category: {{category}}</p>
            <p>Price: ${{price}}</p>
            <p>Stock: {{stock}}</p>

            <a href = "/manager/games/edit/{{id}}">
                <button type="button">Edit Game </button>
            </a>

            <form action="/manager/games/delete/{{id}}" method="POST"
            onsubmit="return confirm('Are you sure you want to delete this game?');">
                    <button type="submit">Delete Game</button>

            </form>

            <hr>

        </div>
    {{/games}}

    {{^games}}
        <p>No games currently available.</p>
    {{/games}}

    <form action="/logout" method="POST">
        <button type="submit">Logout</button>
    </form>

</body>
</html>