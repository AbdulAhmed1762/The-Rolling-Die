<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>

    <h1>The Rolling Die</h1>
    <h2>Available Board Games</h2>

    {{#games}}
        <div>
            <h3>{{title}}</h3>
            <p>Category: {{category}}</p>
            <p>Description: {{description}}</p>
            <p>Price: ${{price}}</p>
            <p>Stock: {{stock}}</p>
            <hr>
        </div>
    {{/games}}

    {{^games}}
        <p>No games currently available.</p>
    {{/games}}

</body>
</html>